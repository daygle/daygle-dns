# Daygle DNS - example configuration
# Copy to /etc/daygle-dns/daygle.toml and adjust as needed.

# Plaintext DNS listeners (UDP/TCP on port 53).
[server]
listen = "0.0.0.0"
port = 53
udp_enabled = true
tcp_enabled = true
tcp_timeout_ms = 5000
response_buffer_size = 4096
# Watch this file and apply policy/upstream/listener edits without restarting.
# (listener settings and other bootstrap options stay file-owned)
reload_enabled = true
reload_interval_ms = 2000

# Recursive resolution (root -> TLD -> authoritative) with caching,
# negative caching, retries and timeouts.
# Runtime settings in this group live in the SQLite database: these values seed
# the database on first boot, after which changes made in the GUI or via
# PUT /api/config are authoritative and survive restarts and file edits.
[recursive]
enabled = true
# Empty list + use_system_config = use /etc/resolv.conf.
# Supported upstream forms:
#   8.8.8.8             plaintext UDP+TCP, port 53
#   1.1.1.1:5353        plaintext UDP+TCP, custom port
#   tls://1.1.1.1:853@cloudflare-dns.com   DNS over TLS
upstreams = []
use_system_config = true
cache_size = 8192
timeout_secs = 5
attempts = 3
dnssec_validate = true
min_cache_ttl = 0
negative_cache_ttl = 3600
# Cache: positive and negative answers are retained in memory up to this many entries.
# The cache can also be viewed and flushed from the GUI's Cache page.
# cache_size = 8192
#
# Cache prefetch: names asked at least `prefetch_min_queries` times inside the
# sliding window are refreshed in the background once `prefetch_ttl_fraction_pct`
# of their TTL has elapsed, so popular answers never wait on an upstream.
prefetch_enabled = false
prefetch_ttl_fraction_pct = 50
prefetch_min_queries = 5
prefetch_window_secs = 300
# Serve-stale: keep serving last-known-good answers for up to this long when
# every upstream is unreachable (0 disables). 1800 = 30 minutes.
serve_stale_secs = 0

# Conditional forwarding: queries for these zones are resolved by the zone's
# own upstreams instead of the defaults above. Useful for split-horizon DNS,
# e.g. forwarding an internal domain to the company AD DNS servers. The most
# specific (deepest) zone wins; upstreams accept the same forms as above.
#
# [[recursive.conditional_zones]]
# name = "corp.internal"
# upstreams = ["192.0.2.10", "192.0.2.11:5353"]

# Authoritative zone storage (SQLite).
[authoritative]
database = "/var/lib/daygle-dns/daygle.db"
# Optional: import BIND zone files (*.zone, *.db, *.txt) from this directory.
zones_dir = "/etc/daygle-dns/zones"
default_primary_ns = "ns1.daygle.test."
default_admin_mailbox = "admin.daygle.test."
dnssec_enabled = true

# DNSSEC maintenance: a background task re-signs zones before their RRSIGs
# expire (at half the validity window) and rolls keys automatically. During
# a rollover the zone is double-signed by the old and new key while both
# DNSKEYs are published; after the overlap the old key is retired (stops
# signing, DNSKEY stays published) and finally removed.
dnssec_sig_validity_days = 14
# Key lifetime before rollover starts; 0 disables rollover entirely.
dnssec_rollover_days = 90
# How long both keys sign and are published before the old key retires.
# Use this window to submit the new DS record to your registrar - automatic
# rollover cannot update the parent's DS for you.
dnssec_rollover_overlap_days = 30
# How long a retired key's DNSKEY stays published after it stops signing.
dnssec_rollover_retire_days = 14
# How often the maintenance task checks signatures and key ages.
dnssec_maintenance_secs = 3600

# Serve AXFR/IXFR zone transfers (RFC 5936) for hosted zones.
# axfr_networks limits which clients may transfer (empty = anyone).
axfr_enabled = false
axfr_networks = ["10.0.0.0/8", "192.168.0.0/16"]

# Accept RFC 2136 dynamic updates (UPDATE messages) for primary zones.
# Changes are written through to SQLite and go live immediately. Off by
# default: anyone who can reach the server could otherwise add records.
# update_networks limits which clients may update (empty = anyone).
allow_dynamic_updates = false
update_networks = ["10.0.0.0/8", "192.168.0.0/16"]

# Secondary zones: replicated from a master via AXFR/IXFR. The zone's
# records and SOA are re-pulled from the first reachable master on
# refresh_secs. Master entries accept IP, IP:port, or [IPv6]:port.
#
# [[authoritative.secondary_zones]]
# name = "internal.example.com"
# masters = ["192.0.2.1", "192.0.2.2:5353"]
# refresh_secs = 600
# enabled = true

# RFC 1996 NOTIFY.
#
# Outbound: when a primary zone changes (e.g. a dynamic update is applied),
# send a NOTIFY to each target so secondaries pull immediately instead of
# waiting out their refresh interval. Requires at least one target.
notify_enabled = false
notify_targets = ["192.0.2.20", "192.0.2.21:5353"]
#
# Inbound: accept NOTIFYs from masters for the secondary zones above and
# refresh the affected zone immediately. The NOTIFY is answered with the
# current SOA; serials are still compared before any transfer, so replayed
# or spoofed NOTIFYs cannot corrupt zone data.
notify_listen_enabled = false

# DNS over TLS (RFC 7858) using rustls.
[dot]
enabled = false
listen = "0.0.0.0"
port = 853
cert_path = "/etc/daygle-dns/certs/server.crt"
key_path = "/etc/daygle-dns/certs/server.key"
# Generate a self-signed certificate when none is present.
self_signed = true
server_name = "dns.example.com"

# DNS over HTTPS (RFC 8484). Disabled by default; serve on 443 with a real
# certificate for public use. Clients POST application/dns-message bodies to
# `endpoint` (default /dns-query).
[doh]
enabled = false
listen = "0.0.0.0"
port = 443
# May reuse the same certificate as DoT.
cert_path = "/etc/daygle-dns/certs/server.crt"
key_path = "/etc/daygle-dns/certs/server.key"
self_signed = true
server_name = "dns.example.com"
endpoint = "/dns-query"

# DNS over QUIC (RFC 9250). One bidirectional QUIC stream per query; RFC 9250
# recommends keeping the connection open (idle timeout >= 600). Defaults to
# reusing the DoT certificate.
[doq]
enabled = false
listen = "0.0.0.0"
port = 853
cert_path = "/etc/daygle-dns/certs/server.crt"
key_path = "/etc/daygle-dns/certs/server.key"
self_signed = true
server_name = "dns.example.com"
idle_timeout_secs = 600

# REST API + embedded web GUI.
[api]
enabled = true
listen = "127.0.0.1"
port = 5380
# Console authentication is ON by default. On first run the GUI offers a
# one-time "create admin account" setup, and every API call needs a login
# session afterwards. Set auth_required = false to serve the console fully
# open (development only).
auth_required = true
# Legacy alternative: a shared static bearer token. Leave empty to use the
# login accounts; when set, it manages auth itself and the setup step is
# disabled. Ignored once console users are configured below.
api_token = ""
# Sessions live for session_ttl_secs (default 12 h).
session_ttl_secs = 43200
# Console accounts are stored in the DATABASE and managed from the console's
# Users page. Entries below are a SEED: imported at startup only when no
# account with the same username exists yet, so GUI-created accounts survive
# config edits. Generate a password hash with:
#   daygle-dns hash-password 'your-password'
# role = "admin" (full access) or "viewer" (read-only; mutations get 403).
# [[api.users]]
# username = "admin"
# password_hash = "pbkdf2-sha256$210000$…$…"
# role = "admin"
gui_enabled = true
cors_origins = []

# Policy engine: trusted domains, blocklists, ACLs and per-client rules.
[policy]
enabled = true
# Allowlist / trusted domains are evaluated before every domain block rule.
# These names are never blocked by the policy engine (ACLs still apply).
allowlist = ["updates.example.com"]
# Blocklist / blocked domains are always answered with NXDOMAIN.
blocklist = ["*.doubleclick.net", "*.ads.example.com"]
# Optional: extra blocklist files on disk (one domain per line). Only
# reference files that exist - a missing file aborts startup. You can
# add your own lists here and reload, or fetch remote lists with
# [[policy.blocklist_sources]] below.
blocklist_files = []

# Filter AAAA (IPv6): answer AAAA queries with an empty NODATA response so
# dual-stack clients fall back to IPv4 (the equivalent of Technitium's
# "Block AAAA" app). `filter_aaaa_except` lists names - or `*.suffix`
# wildcards - that must stay reachable over IPv6.
filter_aaaa = false
filter_aaaa_except = ["*.ipv6.example.com", "nas.home.arpa"]

# Remote blocklist sources: fetched over HTTP(S) and merged into the
# blocklist, refreshed on a schedule (like Technitium's blocklist manager).
# format: "domains" (one per line) | "hosts" (hosts file, e.g. StevenBlack)
#         | "adblock" (AdGuard/uBlock syntax).
#
# [[policy.blocklist_sources]]
# name = "StevenBlack hosts"
# url = "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts"
# format = "hosts"
# refresh_secs = 86400
#
# [[policy.blocklist_sources]]
# name = "AdGuard DNS filter"
# url = "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt"
# format = "adblock"
# refresh_secs = 43200

denied_networks = []
allowed_networks = []

# Ordered per-client rules. `clients` defaults to everyone when empty.
# action: allow | block | redirect
[[policy.rules]]
clients = ["192.168.1.0/24"]
domains = ["*.internal.test"]
action = "redirect"
redirect = "0.0.0.0"

[[policy.rules]]
clients = ["10.0.0.0/8"]
domains = []
action = "block"

# Per-client and per-domain query rate limiting.
# Fixed windows: a client (source IP) or domain (query name) may send at
# most *_max_queries requests per *_window_secs; requests over the limit
# get SERVFAIL and count toward the `rate_limited` metric. Each counter is
# independent. Off by default.
[rate_limit]
enabled = false
client_max_queries = 100
client_window_secs = 60
domain_max_queries = 600
domain_window_secs = 60
# Loopback clients (127.0.0.0/8, ::1) are never rate-limited.
exempt_loopback = true

[logging]
level = "info"
ring_buffer = 2000
# Record every served query into the SQLite database so the console's
# Logs -> Query Logs tab can search, filter, paginate and export them.
# Retention keeps at most this many rows (0 = unlimited).
query_db_enabled = true
query_db_max_rows = 200000
